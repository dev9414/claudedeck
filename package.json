{
  "name": "claudedeck",
  "version": "0.1.0",
  "description": "Mission control for your Claude Code accounts — a cross-platform desktop GUI for multi-account switching, live quota tracking, and usage history.",
  "author": "ClaudeDeck contributors <vaghanidev412@gmail.com>",
  "license": "MIT",
  "main": "./out/main/index.js",
  "bin": {
    "claudedeck": "./out/main/cli/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "claude",
    "claude-code",
    "account-switcher",
    "electron",
    "desktop",
    "rate-limit",
    "usage-dashboard"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "tsc --noEmit -p tsconfig.json",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "validate:palette": "node scripts/validate-palette.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
